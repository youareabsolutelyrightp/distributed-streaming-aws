{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raw-transport-trace-v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "expected_row_count",
    "observed_row_count",
    "uncompressed_sha256",
    "compressed_sha256",
    "compressed_size_bytes",
    "analyzer_sha256",
    "analyzer_source_revision",
    "created_at",
    "s3_key",
    "s3_verified"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 3},
    "expected_row_count": {"type": "integer", "minimum": 0},
    "observed_row_count": {"type": "integer", "minimum": 0},
    "uncompressed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compressed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compressed_size_bytes": {"type": "integer", "minimum": 1},
    "analyzer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analyzer_source_revision": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "s3_key": {"type": "string", "minLength": 1},
    "s3_verified": {"const": true},
    "analysis_passed": {"type": "boolean"},
    "diagnostic_sample_rows": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
