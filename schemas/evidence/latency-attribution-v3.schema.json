{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "latency-attribution-v3",
  "type": "object",
  "required": [
    "schema_version",
    "transport_measurement_versions",
    "analyzer",
    "raw_trace_evidence",
    "complete_attribution",
    "record_count",
    "negative_segment_count",
    "reconstruction_tolerance_us",
    "quantile_method",
    "group_sample_capacity",
    "bucket_sample_capacity",
    "worst_one_percent_attributed_fraction",
    "worst_one_percent",
    "timer_and_input_distributions_separate",
    "by_query_and_trigger",
    "by_query_trigger_and_partition",
    "by_query_trigger_and_checkpoint_activity",
    "worst_100_ten_second_buckets",
    "worst_100_results",
    "worst_100_source_and_shuffle_results"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "transport_measurement_versions": {
      "type": "array",
      "items": {"type": "integer", "enum": [2, 3, 4]},
      "minItems": 1,
      "uniqueItems": true
    },
    "analyzer": {"type": "object"},
    "raw_trace_evidence": {"type": ["object", "null"]},
    "complete_attribution": {"const": true},
    "record_count": {"type": "integer", "minimum": 0},
    "negative_segment_count": {"const": 0},
    "reconstruction_tolerance_us": {"type": "integer", "minimum": 0},
    "quantile_method": {"type": "string"},
    "group_sample_capacity": {"type": "integer", "minimum": 1},
    "bucket_sample_capacity": {"type": "integer", "minimum": 1},
    "worst_one_percent_attributed_fraction": {"type": "number", "minimum": 0.9, "maximum": 1},
    "worst_one_percent": {"type": "object"},
    "timer_and_input_distributions_separate": {"const": true},
    "by_query_and_trigger": {"type": "object"},
    "derived_by_query_and_trigger": {"type": "object"},
    "coordination_details_by_query_and_trigger": {"type": "object"},
    "by_query_trigger_and_partition": {"type": "object"},
    "by_query_trigger_and_checkpoint_activity": {"type": "object"},
    "worst_100_ten_second_buckets": {"type": "array"},
    "worst_100_results": {"type": "array", "maxItems": 100},
    "worst_100_source_and_shuffle_results": {"type": "array", "maxItems": 100}
  },
  "additionalProperties": false
}
